{
  "exclude": [
    "**/frontend/vendor/**",
    "**/typescript/compat/syntax.cjs",
    "**/typescript/providers/vercel/runtime.cjs",
    "**/*.test.*",
    "*/jsts/src/rules/*/generated-meta.*",
    "**/tests/**/*",
    "**/fixtures/**/*",
    "tools/*"
  ],
  "reporter": ["lcov", "text-summary"],
  "report-dir": "coverage/js/"
}
