{
  "name": "typescript",
  "version": "6.0.3",
  "private": true,
  "description": "SonarJS compiler contract for in-process providers",
  "type": "commonjs",
  "main": "./index.cjs",
  "types": "./index.d.cts",
  "bin": {
    "tsc": "./tsc.cjs"
  },
  "exports": {
    "./contract": {
      "types": "./contract.d.cts",
      "default": "./contract.cjs"
    },
    "./lifecycle": {
      "types": "./lifecycle.d.cts",
      "default": "./lifecycle.cjs"
    },
    "./errors": {
      "types": "./errors.d.cts",
      "default": "./errors.cjs"
    },
    ".": {
      "types": "./index.d.cts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./lib/typescript": {
      "types": "./index.d.cts",
      "default": "./index.cjs"
    },
    "./lib/typescript.js": {
      "types": "./index.d.cts",
      "default": "./index.cjs"
    },
    "./lib/tsserverlibrary": {
      "types": "./index.d.cts",
      "default": "./index.cjs"
    },
    "./lib/tsserverlibrary.js": {
      "types": "./index.d.cts",
      "default": "./index.cjs"
    },
    "./package.json": "./package.json",
    "./selection": {
      "types": "./selection.d.cts",
      "default": "./selection.cjs"
    }
  }
}
