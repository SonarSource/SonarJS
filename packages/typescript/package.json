{
  "name": "typescript",
  "version": "6.0.3",
  "private": true,
  "description": "SonarJS-owned TypeScript-compatible compiler module",
  "type": "commonjs",
  "main": "./index.cjs",
  "types": "./index.d.cts",
  "exports": {
    ".": {
      "types": "./index.d.cts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./control": {
      "types": "./control.d.cts",
      "import": "./control.mjs",
      "require": "./control.cjs"
    },
    "./errors": {
      "types": "./errors.d.cts",
      "default": "./errors.cjs"
    },
    "./lib/typescript": {
      "types": "./index.d.cts",
      "default": "./index.cjs"
    },
    "./lib/typescript.js": {
      "types": "./index.d.cts",
      "default": "./index.cjs"
    },
    "./lib/tsserverlibrary": {
      "types": "./index.d.cts",
      "default": "./index.cjs"
    },
    "./lib/tsserverlibrary.js": {
      "types": "./index.d.cts",
      "default": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  }
}
