{
  "defaultProvider": "tsgo-wasm",
  "providers": {
    "tsgo-ipc": {
      "module": "./providers/tsgo-ipc/index.mjs",
      "libraries": "../../target/tsgo-ipc/native",
      "sdk": "typescript-go",
      "libraryDestination": "tsgo",
      "platforms": [
        "darwin-arm64",
        "darwin-x64",
        "linux-arm64",
        "linux-x64",
        "win32-arm64",
        "win32-x64"
      ],
      "bundleLibraries": true,
      "prepare": "tools/prepare-tsgo-provider.mjs",
      "legacyModuleResolution": false,
      "capabilities": {
        "watchPrograms": false,
        "projectService": false
      }
    },
    "ts6": {
      "module": "./providers/classic.cjs",
      "libraries": "../../node_modules/typescript-classic/lib",
      "sdk": "typescript-classic",
      "capabilities": {
        "watchPrograms": true,
        "projectService": true
      },
      "legacyModuleResolution": true
    },
    "tsgo-wasm": {
      "module": "../../target/tsgo-wasm/provider.mjs",
      "source": "./providers/tsgo-wasm/index.mjs",
      "libraries": "../../target/tsgo-wasm/assets",
      "sdk": "typescript-go-wasm",
      "libraryDestination": "tsgo-wasm",
      "bundleLibraries": true,
      "prepare": "tools/prepare-tsgo-wasm-provider.mjs",
      "metafile": "target/tsgo-wasm/provider-meta.json",
      "legacyModuleResolution": false,
      "capabilities": {
        "watchPrograms": false,
        "projectService": false
      },
      "wasmPackage": "tsgo-wasm"
    }
  }
}
