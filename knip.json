{
  "ignore": [
    "packages/analysis/src/jsts/parsers/estree.d.ts",
    "packages/grpc/src/proto/*.d.ts",
    "packages/shared/src/fs-cache/archive-proto.d.ts",
    "packages/analysis/src/program-selection/analysis-metadata-proto.d.ts",
    "packages/analysis/src/jsts/rules/plugin.ts",
    "packages/analysis/src/jsts/rules/*/*.fixture.*",
    "**/fixtures/**",
    "**/fixtures-*/**",
    "its/**",
    "tools/header.ts",
    "tools/new-plugin.ts"
  ],
  "project": ["packages/**/*.ts", "tools/**/*.ts"],
  "ignoreDependencies": [
    "nyc",
    "@istanbuljs/esm-loader-hook",
    "esbuild-plugin-copy",
    "esbuild-plugin-text-replace"
  ],
  "ignoreBinaries": ["mvn"],
  "ignoreIssues": {
    "packages/analysis/src/jsts/frontend/vendor/**": ["files", "exports", "types"],
    "packages/typescript/index.mjs": ["exports", "types"]
  },
  "entry": [
    "packages/typescript/index.cjs",
    "packages/typescript/compat/index.cjs",
    "tools/compiler-provider-plugin.mjs",
    "packages/typescript/providers/classic.cjs"
  ]
}
